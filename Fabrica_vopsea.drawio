        <mxCell id="vH4wrptssR_M-zVdbT-1-165" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Legendă&lt;/h1&gt;&lt;p&gt;ZS11&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;=&amp;nbsp; senzor porcușor 1 aflat la sender&lt;/p&gt;&lt;p&gt;ZS12&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;= senzor porcușor 2 aflat la sender&lt;/p&gt;&lt;p&gt;ZS21&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;= senzor porcușor 1 aflat la receiver&lt;/p&gt;&lt;p&gt;ZS22&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;= senzor porcușor 2 aflat la receiver&lt;/p&gt;&lt;p&gt;PLS_&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;= vanele de la sender&lt;/p&gt;&lt;p&gt;PRS_&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;= vanele de receiver&lt;/p&gt;&lt;p&gt;_XV21&amp;nbsp; &amp;nbsp; &amp;nbsp;= vană spate porcușor&lt;/p&gt;&lt;p&gt;_XV22&amp;nbsp; &amp;nbsp; &amp;nbsp;= vană față porcușor / mijloc porcușori 1,2&lt;/p&gt;&lt;p&gt;_XV91&amp;nbsp; &amp;nbsp; &amp;nbsp;= apa + pompa&lt;/p&gt;&lt;p&gt;_XV51&amp;nbsp; &amp;nbsp; &amp;nbsp;= air la presiunea de 1,8 bari&lt;/p&gt;&lt;p&gt;_XV81&amp;nbsp; &amp;nbsp; &amp;nbsp;= waste&lt;/p&gt;&lt;p&gt;PVC51&amp;nbsp; &amp;nbsp; &amp;nbsp;= vana acționată pe bază de senzor de presiune&lt;/p&gt;&lt;p&gt;PT13&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; = senzor presiune&lt;/p&gt;&lt;p&gt;OUT*_SZ^&amp;nbsp; = senzorul pentru porcușorul ^ de la ieșirea *&amp;nbsp;&lt;/p&gt;" vertex="1">
